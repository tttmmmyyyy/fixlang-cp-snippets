module Snippets.SqrtMod;

import CPLib.Arithmetic;

// mod での平方根

// 素数`p`を法とする`a`の平方根を1つ求める
//
// z^2 = a (mod p) を満たす`[0, p)`の z を1つ返す。平方根がなければ`none()`を返す。
//
// 制約：`p`は素数
//
// 計算量：O(log(p)^2)（平方非剰余を探す部分は期待値）
//
// # Parameters
// - `p`: 法（素数）
// - `a`: 整数
//
// # Examples
// ```fix
// let z = 2.calc_sqrt_mod_prime(7).as_some;
// assert_eq(|_|"", z * z % 7, 2);;
// assert_eq(|_|"", 3.calc_sqrt_mod_prime(7), none())
// ```
calc_sqrt_mod_prime : I64 -> I64 -> Option I64 = |p, a| (
    // Tonelli–Shanks 法
    let a = a.pmod(p);
    if a == 0 || p == 2 { a.some };
    if a.pow_mod((p - 1) / 2, p) != 1 { none() };
    if p % 4 == 3 { a.pow_mod((p + 1) / 4, p).some };
    // p - 1 = q 2^s, q は奇数
    let (q, s) = loop((p - 1, 0), |(q, s)|
        if q % 2 != 0 { break $ (q, s) };
        continue $ (q / 2, s + 1)
    );
    let z = count_up(2).filter(|z| z.pow_mod((p - 1) / 2, p) == p - 1).get_first.as_some;
    // 不変条件：r^2 = a t (mod p)、c^(2^(m-1)) = -1、t^(2^(m-1)) = 1
    loop((s, z.pow_mod(q, p), a.pow_mod(q, p), a.pow_mod((q + 1) / 2, p)), |(m, c, t, r)|
        if t == 1 { break $ r.some };
        // t^(2^i) = 1 となる最小の i（0 < i < m）
        let i = loop((1, mul_mod(t, t, p)), |(i, t2)|
            if t2 == 1 { break $ i };
            continue $ (i + 1, mul_mod(t2, t2, p))
        );
        let b = range(0, m - i - 1).fold(c, |_, b| mul_mod(b, b, p));
        let b2 = mul_mod(b, b, p);
        continue $ (i, b2, mul_mod(t, b2, p), mul_mod(r, b, p))
    )
);

// 素数`p`と互いに素な`u`について、`p^k`を法とする`u`の平方根をすべて求める
//
// 制約：`p`は素数、`u`と`p`は互いに素、`k >= 1`
//
// # Parameters
// - `u`: 整数
// - `p`: 素数
// - `k`: 指数
_calc_sqrts_mod_prime_power_unit : I64 -> I64 -> I64 -> Array I64 = |u, p, k| (
    if p == 2 {
        // 2^j を法とする平方根の集合を、j = 1 から順に 2^(j+1) を法とするものへ持ち上げる。集合の大きさは 4 以下。
        range(1, k).fold([1], |j, rs|
            let mj = 1.shift_left(j);
            let mj1 = 2 * mj;
            let u1 = u.pmod(mj1);
            rs.to_iter.flat_map(|r| [r, r + mj].to_iter).filter(|c| mul_mod(c, c, mj1) == u1).to_array
        )
    };
    match u.calc_sqrt_mod_prime(p) {
        none() => [],
        some(r) => (
            // Hensel の補題で p^j から p^(j+1) へ持ち上げる
            let (r, pk) = range(1, k).fold((r, p), |_, (r, pj)|
                let pj1 = pj * p;
                let f = (mul_mod(r, r, pj1) - u).pmod(pj1);
                let r = (r - mul_mod(f, mul_mod(2, r, pj1).inv_mod(pj1), pj1)).pmod(pj1);
                (r, pj1)
            );
            [r, pk - r]
        )
    }
);

// 素数`p`について、`p^k`を法とする`a`の平方根をすべて求める
//
// 制約：`p`は素数、`k >= 1`
//
// # Parameters
// - `a`: 整数
// - `p`: 素数
// - `k`: 指数
_calc_sqrts_mod_prime_power : I64 -> I64 -> I64 -> Array I64 = |a, p, k| (
    let pk = p.power(k);
    let a = a.pmod(pk);
    // a = 0 なら、z = 0 (mod p^ceil(k/2)) となる z がすべて平方根
    if a == 0 {
        let h = p.power((k + 1) / 2);
        range(0, pk / h).map(|t| t * h).to_array
    };
    // a = p^v u（u と p は互いに素）。v が奇数なら平方根はない。
    let (v, u) = loop((0, a), |(v, u)|
        if u % p != 0 { break $ (v, u) };
        continue $ (v + 1, u / p)
    );
    if v % 2 != 0 { [] };
    // z = p^w y（w = v/2）とおくと y^2 = u (mod p^(k-v))。y は p^(k-w) を法として決まるので、
    // p^(k-v) を法とする根 y0 ごとに y = y0 + p^(k-v) t（0 <= t < p^w）がある。
    let w = v / 2;
    let pw = p.power(w);
    let pkv = p.power(k - v);
    _calc_sqrts_mod_prime_power_unit(u, p, k - v).to_iter.flat_map(|y0|
        range(0, pw).map(|t| pw * (y0 + pkv * t))
    ).to_array
);

// `m`を法とする`a`の平方根をすべて求める
//
// z^2 = a (mod m) を満たす`[0, m)`の z をすべて、小さい順に返す。
//
// 制約：m >= 1
//
// 計算量：O(m^(1/4) log(m) + N log(m))（前の項は期待値）。N は平方根の個数。
//
// # Parameters
// - `m`: 法
// - `a`: 整数
//
// # Examples
// ```fix
// assert_eq(|_|"", 1.calc_sqrts_mod(8), [1, 3, 5, 7]);;
// assert_eq(|_|"", 4.calc_sqrts_mod(12), [2, 4, 8, 10])
// ```
calc_sqrts_mod : I64 -> I64 -> Array I64 = |m, a| (
    if m < 1 { undefined("[calc_sqrts_mod] `m` is less than 1") };
    a._calc_sqrts_mod_factorized(m.factorize)
);

// 素因数分解が`factors`である数を法として、`a`の平方根をすべて、小さい順に返す
//
// 制約：`factors`は`factorize`の戻り値と同じ形（素因子が昇順で、指数が1以上）
//
// # Parameters
// - `factors`: 法の素因数分解
// - `a`: 整数
_calc_sqrts_mod_factorized : Array (I64, U8) -> I64 -> Array I64 = |factors, a| (
    // 素数べきごとに平方根を求め、中国剰余定理で組み合わせる
    // zs は、それまでに処理した素数べきの積 n を法とする平方根
    let (zs, _) = factors.to_iter.fold(([0], 1), |(p, k), (zs, n)|
        let pk = p.power(k.i64);
        let ys = _calc_sqrts_mod_prime_power(a, p, k.i64);
        let zs = zs.to_iter.flat_map(|z| ys.to_iter.map(|y| let (r, _) = lift_crt([z, y], [n, pk]); r)).to_array;
        (zs, n * pk)
    );
    zs.sort
);
